{
  "version": 1,
  "banners": {
    "generated": "DO NOT EDIT. Generated for tests.",
    "policySource": ".agents/policies/"
  },
  "slots": {
    "prelude": {
      "supportedBy": [
        "cursor-rule",
        "claude-doc",
        "claude-rule",
        "agents-doc",
        "gemini-doc",
        "github-copilot",
        "copilot-scoped",
        "plain-markdown"
      ]
    },
    "body": {
      "supportedBy": [
        "cursor-rule",
        "claude-doc",
        "claude-rule",
        "agents-doc",
        "gemini-doc",
        "github-copilot",
        "copilot-scoped",
        "plain-markdown"
      ]
    }
  },
  "targets": {
    "cursor-rule": {
      "kind": "cursor-rule",
      "fileExtension": ".mdc",
      "bannerStyle": "html-comment-after-frontmatter"
    },
    "claude-doc": {
      "kind": "claude-doc",
      "fileExtension": ".md",
      "bannerStyle": "html-comment-top"
    },
    "claude-rule": {
      "kind": "claude-rule",
      "fileExtension": ".md",
      "bannerStyle": "html-comment-top"
    },
    "agents-doc": {
      "kind": "agents-doc",
      "fileExtension": ".md",
      "bannerStyle": "html-comment-top"
    },
    "github-copilot": {
      "kind": "github-copilot",
      "fileExtension": ".md",
      "bannerStyle": "html-comment-top"
    },
    "gemini-doc": {
      "kind": "gemini-doc",
      "fileExtension": ".md",
      "bannerStyle": "html-comment-top"
    },
    "copilot-scoped": {
      "kind": "copilot-scoped",
      "fileExtension": ".instructions.md",
      "bannerStyle": "html-comment-after-frontmatter"
    },
    "plain-markdown": {
      "kind": "plain-markdown",
      "fileExtension": ".md",
      "bannerStyle": "html-comment-top"
    }
  },
  "validation": {
    "requireFrontmatter": true,
    "requireUniqueIds": "per-module",
    "forbidUnknownFrontmatterFields": true,
    "failOnEmptyTargetSet": true,
    "failOnUnknownSlot": true,
    "failOnUnknownTarget": true,
    "failOnRequiresCycle": true
  },
  "compose": {
    "alwaysInclude": ["global"],
    "globalSlotInjection": {
      "prelude": "first"
    }
  }
}
